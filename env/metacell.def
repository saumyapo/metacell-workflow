Bootstrap: docker
From: condaforge/miniforge3:24.9.2-0

# Python side of the workflow: steps 01, 02 and 04.
# Built from env/metacell.yml so the container and a local conda env are the
# same set of packages, not two things that drift.
#
# Build (needs root or fakeroot, so a login node or a CI runner, not a
# compute node):
#     apptainer build env/metacell.sif env/metacell.def
#
# Run:
#     apptainer exec --bind "$PWD":"$PWD" --pwd "$PWD" env/metacell.sif \
#         python3 scripts/01_preprocess.py

%files
    env/metacell.yml /opt/metacell.yml

%post
    set -eux

    # system libraries the conda packages link against but do not vendor
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential git ca-certificates && rm -rf /var/lib/apt/lists/*

    # solve once at build time and bake the result in. libmamba is the default
    # solver in miniforge, so this is a few minutes rather than an afternoon.
    conda env create -f /opt/metacell.yml -n metacell
    conda clean -afy

    # record exactly what landed, so a container can be audited without running it
    conda run -n metacell conda list --explicit > /opt/metacell.lock
    conda run -n metacell pip freeze > /opt/metacell.pip.txt

%environment
    export PATH=/opt/conda/envs/metacell/bin:$PATH
    export CONDA_DEFAULT_ENV=metacell
    # MC2 sets its own worker count from the scheduler, keep BLAS from
    # oversubscribing on top of it
    export OMP_NUM_THREADS=1
    export OPENBLAS_NUM_THREADS=1
    export MKL_NUM_THREADS=1

%runscript
    exec python3 "$@"

%test
    python3 -c "import metacells, scanpy, anndata, numpy; \
        print('metacells', metacells.__version__); \
        print('scanpy', scanpy.__version__); \
        print('numpy', numpy.__version__)"

%labels
    Stage python
    Steps 01,02,04
